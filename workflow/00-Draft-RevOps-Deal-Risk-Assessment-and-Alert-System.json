    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const $json = item.json;\n  const p = $json.properties ?? {};\n  const now = Date.now();\n  const MS_PER_DAY = 86400000;\n\n  // Parsed Fields\n  const dealId = String($json.id ?? '');\n  const dealName = String(p.dealname ?? '').trim();\n  const rawAmount = p.amount === '' || p.amount == null ? null : Number(p.amount);\n  const amount = Number.isFinite(rawAmount) ? rawAmount : null;\n  const closeDate = p.closedate ? new Date(p.closedate) : null;\n  const lastModified = p.hs_lastmodifieddate ? new Date(p.hs_lastmodifieddate) : null;\n  const stage = String(p.dealstage ?? '');\n  const pipeline = String(p.pipeline ?? '');\n  const ownerId = String(p.hubspot_owner_id ?? '');\n  const nextStep = String(p.hs_next_step ?? '').trim();\n\n  // State\n  const issues = [];\n  const riskDrivers = [];\n  const scoreBreakdown = { base: 0 };\n  let riskScore = 0;\n  let highestIssueSeverity = 'NONE';\n\n  // Severity Ranking Map\n  const severityRank = {\n    NONE: 0,\n    LOW: 1,\n    MEDIUM: 2,\n    HIGH: 3,\n    CRITICAL: 4\n  };\n\n  // Helper function to handle issue logging cleanly\n  function addRisk(code, severity, points, driverMsg, breakdownKey, detail = null) {\n    issues.push({ code, severity, points, ...(detail && { detail }) });\n    riskScore += points;\n    scoreBreakdown[breakdownKey] = points;\n    riskDrivers.push(driverMsg);\n    \n    // Evaluate highest severity using the rank map\n    if (severityRank[severity] > severityRank[highestIssueSeverity]) {\n      highestIssueSeverity = severity;\n    }\n  }\n\n  // 1. Forecast & Accountability Risk\n  if (amount == null || !Number.isFinite(amount) || amount <= 0) {\n    addRisk('MISSING_OR_INVALID_AMOUNT', 'HIGH', 15, 'Deal value missing/invalid, reducing forecast reliability.', 'missingAmount');\n  }\n  if (!ownerId) {\n    addRisk('UNASSIGNED_DEAL', 'HIGH', 10, 'No deal owner assigned, creating execution risk.', 'missingOwner');\n  }\n  if (!nextStep) {\n    addRisk('MISSING_NEXT_STEP', 'MEDIUM', 10, 'No documented next step, increasing execution risk.', 'missingNextStep');\n  }\n\n  // 2. Close Date Slippage Risk\n  let daysToClose = null;\n  if (!closeDate || Number.isNaN(closeDate.getTime())) {\n    addRisk('MISSING_CLOSE_DATE', 'HIGH', 15, 'No reliable close date available for forecasting.', 'missingCloseDate');\n  } else {\n    daysToClose = Math.ceil((closeDate.getTime() - now) / MS_PER_DAY);\n    if (daysToClose < 0) {\n      const expiredDays = Math.abs(daysToClose);\n      const points = expiredDays >= 91 ? 35 : expiredDays >= 61 ? 30 : expiredDays >= 31 ? 25 : expiredDays >= 15 ? 20 : expiredDays >= 8 ? 15 : 10;\n      const severity = expiredDays >= 15 ? 'HIGH' : 'MEDIUM';\n      addRisk('EXPIRED_CLOSE_DATE', severity, points, `Close date ${expiredDays} days overdue, indicating forecast slippage.`, 'expiredCloseDate', `Expired ${expiredDays} days ago`);\n    }\n  }\n\n  // 3. Momentum & Stalled Deal Risk\n  let inactiveDays = null; // null = unknown, not \"fresh\"\n  if (!lastModified || Number.isNaN(lastModified.getTime())) {\n    addRisk('MISSING_ACTIVITY_DATA', 'MEDIUM', 5, 'Activity timestamp missing, limiting momentum assessment.', 'missingLastModified');\n  } else {\n    inactiveDays = Math.max(0, Math.floor((now - lastModified.getTime()) / MS_PER_DAY));\n    if (inactiveDays >= 60) {\n      addRisk('SEVERELY_STALLED_DEAL', 'HIGH', 25, `No CRM update for ${inactiveDays} days, deal momentum is dead.`, 'severelyStaleDeal');\n    } else if (inactiveDays >= 30) {\n      addRisk('STALLED_DEAL', 'HIGH', 20, `No CRM update for ${inactiveDays} days, deal is stalling.`, 'staleDeal');\n    } else if (inactiveDays >= 14) {\n      addRisk('LOSING_MOMENTUM', 'MEDIUM', 10, `Activity aging at ${inactiveDays} days, momentum slowing.`, 'agingActivity');\n    }\n  }\n\n  // 4. Execution Gap (Unrealistic Pipeline)\n  if (daysToClose !== null && daysToClose >= 0 && daysToClose <= 7 && (!nextStep || inactiveDays === null || inactiveDays >= 7)) {\n    addRisk('NEAR_CLOSE_EXECUTION_GAP', 'HIGH', 15, `Close date is ${daysToClose} days away without reliable execution signal.`, 'nearCloseExecutionGap');\n  }\n\n  // 5. Final Scoring\n  const highValue = Number.isFinite(amount) && amount >= 100000;\n  if (highValue && riskScore > 0) riskDrivers.push('High-value opportunity: prioritize risk review.');\n  \n  riskScore = Math.max(0, Math.min(100, riskScore));\n  const riskLevel = riskScore >= 60 ? 'CRITICAL' : riskScore >= 40 ? 'HIGH' : riskScore >= 20 ? 'MODERATE' : 'LOW';\n\n  return {\n    json: {\n      dealId, dealName, amount, stage, pipeline, ownerId, nextStep,\n      closeDate: p.closedate || null,\n      lastModified: p.hs_lastmodifieddate || null,\n      inactiveDays, daysToClose, highValue, riskScore, riskLevel,\n      highestIssueSeverity, issues,\n      issueCodes: issues.map(i => i.code),\n      issueCount: issues.length,\n      riskDrivers: [...new Set(riskDrivers)],\n      scoreBreakdown: { ...scoreBreakdown, final: riskScore },\n      assessedAt: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        160
      ],
      "id": "71c1f8e3-f1b8-45a2-b090-e0a838b6cbb1",
      "name": "Code - Deal Risk Engine",
      "notes": "Core deterministic revenue/deal-risk assessment."
    },
    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json);let low=0,moderate=0,high=0,critical=0,highValueRiskCount=0,exposure=0;for(const r of rows){if(r.riskLevel==='LOW')low++;else if(r.riskLevel==='MODERATE')moderate++;else if(r.riskLevel==='HIGH')high++;else if(r.riskLevel==='CRITICAL')critical++;if(r.highValue&&(r.riskLevel==='HIGH'||r.riskLevel==='CRITICAL'))highValueRiskCount++;if((r.riskLevel==='HIGH'||r.riskLevel==='CRITICAL')&&Number.isFinite(Number(r.amount)))exposure+=Number(r.amount);}return [{json:{runTimestamp:new Date().toISOString(),executionId:$execution.id,dealsScanned:rows.length,lowRiskCount:low,moderateRiskCount:moderate,highRiskCount:high,criticalRiskCount:critical,highValueRiskCount,totalExposureHighCritical:exposure}}];"
      },
