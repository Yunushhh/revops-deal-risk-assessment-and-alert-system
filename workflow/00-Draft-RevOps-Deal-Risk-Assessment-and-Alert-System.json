    {
      "parameters": {
        "jsCode": "const riskItems = $('IF - High/Critical Risk').all().map(item => item.json);\nconst aiItems = $input.all().map(item => item.json);\n\n// Reattach deterministic risk data using the deal ID, not n8n item-linking metadata\n// and not array position. This remains correct if item order changes downstream.\nconst riskByDealId = new Map(\n  riskItems.map(risk => [String(risk.dealId), risk])\n);\n\nconst results = [];\n\nfor (let index = 0; index < aiItems.length; index++) {\n  const ai = aiItems[index].output ?? {};\n  const dealId = String(ai.deal_id ?? '').trim();\n\n  if (!dealId) {\n    throw new Error(`AI output is missing deal_id for item ${index}. Refusing to attach risk data by position.`);\n  }\n\n  const risk = riskByDealId.get(dealId);\n\n  if (!risk) {\n    throw new Error(`AI returned unknown deal_id \"${dealId}\" for item ${index}. Refusing to build an action.`);\n  }\n\n  const systemUrgency =\n    risk.riskLevel === 'CRITICAL'\n      ? 'CRITICAL'\n      : risk.riskLevel === 'HIGH'\n        ? 'HIGH'\n        : 'MEDIUM';\n\n  const clean = (value, fallback) =>\n    typeof value === 'string' && value.trim()\n      ? value.trim()\n      : fallback;\n\n  results.push({\n    json: {\n      ...risk,\n      aiRiskAssessment: clean(\n        ai.risk_assessment,\n        'High-risk opportunity requires review.'\n      ),\n      aiBusinessImpact: clean(\n        ai.business_impact,\n        'Potential forecast or execution risk identified.'\n      ),\n      aiNextBestAction: clean(\n        ai.next_best_action,\n        'Review the highest-priority risk driver.'\n      ),\n      systemUrgency,\n      humanReviewRequired: true,\n      actionStatus: 'REVIEW_REQUIRED'\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        160
