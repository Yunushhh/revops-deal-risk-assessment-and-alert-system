      ],
      "id": "507346d4-20d9-4813-8b22-dd89e91d28d1",
      "name": "AI - Revenue Risk Analyst",
      "onError": "continueErrorOutput",
      "notes": "AI interprets business impact and recommends action; deterministic risk data is reattached using the exact deal ID returned by the structured AI output."
